{
  "version": 1,
  "kind": "layout",
  "id": "bright",
  "extends": "fresh",
  "order": 3,
  "name": "明快",
  "description": "行距宽松，按键带实色底边，回车常驻强调色并显示文字，工具栏图标在右侧圆形按钮里",
  "theme": "azure",
  "geometry": {
    "gapH": 5,
    "gapV": 10,
    "padH": 3,
    "radius": 6,
    "radiusLarge": 8
  },
  "qwerty": {
    "rows": [
      [
        "qwertyuiop"
      ],
      [
        "asdfghjkl"
      ],
      [
        "shift:1.4",
        "gap:0.1",
        "zxcvbnm",
        "gap:0.1",
        "delete:1.4"
      ],
      [
        "symbol:1.3",
        "number:1.3",
        "comma",
        "space:2.6",
        "period",
        "lang:1.2",
        "enter:1.6"
      ]
    ],
    "hintSize": 9.5
  },
  "t9": {
    "right": [
      "delete",
      "reset",
      "zero",
      "enter"
    ],
    "bottom": [
      "symbol",
      "number",
      "space",
      "lang"
    ]
  },
  "labels": {
    "enter": "text",
    "enterAccent": "always",
    "space": "iconMic"
  },
  "toolbar": {
    "items": [
      "menu",
      "emoji",
      "voice",
      "clipboard",
      "hide"
    ],
    "align": "edges",
    "buttons": "circle"
  },
  "popup": {
    "radius": 8
  }
}
